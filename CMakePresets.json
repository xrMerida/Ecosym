{
    "version": 3,
    "configurePresets": [
        {
            "name": "unix-base",
            "description": "For more information: http://aka.ms/cmakepresetsvs",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/",
            "installDir": "${sourceDir}/build/install/",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "Windows-debug",
            "displayName": "Windows Debug",
            "description": "Sets debug build type, x64 arch, and cl compiler",
            "inherits": "unix-base",
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },
            "cacheVariables": {
                "CMAKE_C_COMPILER": "cl",
                "CMAKE_CXX_COMPILER": "cl",
                "CMAKE_BUILD_TYPE": "Debug"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "Windows-release",
            "displayName": "Windows Release",
            "description": "Sets release build type",
            "inherits": "Windows-debug",
            "binaryDir": "${sourceDir}/release/"
        },
        {
            "name": "Linux-debug",
            "displayName": "Linux Debug",
            "description": "Sets debug build type",
            "inherits": "unix-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "Linux-release",
            "displayName": "Linux Release",
            "description": "Sets release build type",
            "inherits": "Linux-debug",
            "binaryDir": "${sourceDir}/release/",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "Darwin-debug",
            "displayName": "MacOS Debug",
            "description": "Sets debug build type",
            "inherits": "unix-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            }
        },
        {
            "name": "Darwin-release",
            "displayName": "MacOS Release",
            "description": "Sets release build type",
            "inherits": "Darwin-debug",
            "binaryDir": "${sourceDir}/release/",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "debug-build-Linux",
            "displayName": "Linux Debug",
            "configurePreset": "Linux-debug",
            "description": "Build with debug symbols"
        },
        {
            "name": "debug-build-Windows",
            "displayName": "Windows Debug",
            "configurePreset": "Windows-debug",
            "description": "Build with debug symbols"
        },
        {
            "name": "debug-build-Darwin",
            "displayName": "Darwin Debug",
            "configurePreset": "Darwin-debug",
            "description": "Build with debug symbols"
        },
        {
            "name": "release-build-Linux",
            "displayName": "Linux Release",
            "configurePreset": "Linux-release",
            "description": "Vanilla build"
        },
        {
            "name": "release-build-Windows",
            "displayName": "Windows Release",
            "configurePreset": "Windows-release",
            "description": "Vanilla build"
        },
        {
            "name": "release-build-Darwin",
            "displayName": "Darwin Release",
            "configurePreset": "Darwin-release",
            "description": "Vanilla build"
        }
    ]
}
